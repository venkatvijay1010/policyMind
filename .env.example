# Environment Configuration
# Copy this file to .env and fill in the values

# Local LLM: install Ollama, then run:
#   ollama pull qwen2.5:3b
#   ollama pull nomic-embed-text
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
# Required by the compatibility client but ignored by local Ollama.
LLM_API_KEY=ollama

# SQLite is created automatically on first app start.
DATABASE_URL=sqlite+aiosqlite:///./data/policymind.db
DATABASE_SYNC_URL=sqlite:///./data/policymind.db

# App Settings
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:3b
LLM_MAX_TOKENS=220
EMBEDDING_DIMENSION=768

# Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Search Settings
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.7
RERANK_CANDIDATE_MULTIPLIER=3
MAX_CONTEXT_CHARS=6000

# Request and ingestion safeguards
RATE_LIMIT=60/minute
# Use a shared backend (for example Redis) when running multiple API replicas.
RATE_LIMIT_STORAGE_URI=memory://
# URL ingestion is disabled until explicit trusted HTTPS hosts are listed.
SOURCE_INGEST_ALLOWED_HOSTS=
MAX_INGEST_FILE_BYTES=10485760
SOURCE_FETCH_TIMEOUT_SECONDS=10
PDF_MAX_PAGES=200
PDF_RENDER_DPI=200
PDF_MAX_RENDER_PIXELS=20000000
PDF_OCR_TIMEOUT_SECONDS=30
PDF_EXTRACTION_TIMEOUT_SECONDS=180
PDF_MAX_EXTRACTED_CHARS=2000000
PDF_MIN_NATIVE_CHARS_PER_PAGE=40
PDF_OCR_REVIEW_CONFIDENCE=60

# CORS Settings (comma-separated origins, or * for all)
CORS_ORIGINS=*
