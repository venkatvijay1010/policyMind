# Environment Configuration
# Copy this file to .env and fill in the values

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Database
DATABASE_URL=postgresql+asyncpg://policymind:policymind@localhost:5432/policymind
DATABASE_SYNC_URL=postgresql://policymind:policymind@localhost:5432/policymind

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=policymind

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4-turbo-preview
EMBEDDING_DIMENSION=1536

# Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Search Settings
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7
